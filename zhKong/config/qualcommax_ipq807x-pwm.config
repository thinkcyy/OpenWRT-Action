# 激活 OpenWrt 全局内核 PWM 核心支持
CONFIG_PWM_SUPPORT=y

# 启用高通 IPQ 平台特定的 PWM 控制器硬件驱动 (对应 qca,ipq4019-pwm)
CONFIG_PACKAGE_kmod-pwm-ipq4019=m


# 启用硬件监控核心组件及 PWM 风扇驱动
CONFIG_PACKAGE_kmod-hwmon-core=m
CONFIG_PACKAGE_kmod-hwmon-pwmfan=m

# Kimi
CONFIG_PACKAGE_CONFIG_PWM_IPQ=m
CONFIG_SENSORS_PWM_FAN=m
CONFIG_PWM=y
