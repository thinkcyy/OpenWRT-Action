#!/bin/sh

TABLE="inet fw4"
SET_NAME="maccontrol_allow_set"

init_nft_set() {
    if ! nft list set $TABLE $SET_NAME >/dev/null 2>&1; then
        nft add set $TABLE $SET_NAME '{ type ether_addr; flags timeout; }'
    fi

    if ! nft list chain $TABLE forward | grep -q "@$SET_NAME"; then
        nft insert rule $TABLE forward ether saddr "@$SET_NAME" accept
    fi
}

clean_mac() {
    echo "$1" | tr -d ':' | tr '[:lower:]' '[:upper:]'
}

case "$1" in
    get_known_macs)
        cat /tmp/dhcp.leases 2>/dev/null | while read -r ts mac ip name clid; do
            [ "$name" = "*" ] && name="Unknown"
            echo "$mac|$name ($ip)"
        done | sort -u
        ;;

    add_block)
        MAC=$(echo "$2" | tr '[:lower:]' '[:upper:]')
        [ -z "$MAC" ] && exit 1
        SECTION_NAME="macblock_$(clean_mac "$MAC")"

        if ! uci get firewall."$SECTION_NAME" >/dev/null 2>&1; then
            uci set firewall."$SECTION_NAME"=rule
            uci set firewall."$SECTION_NAME".name="MacControl_Block_$MAC"
            uci set firewall."$SECTION_NAME".src='lan'
            uci set firewall."$SECTION_NAME".dest='wan'
            uci set firewall."$SECTION_NAME".src_mac="$MAC"
            uci set firewall."$SECTION_NAME".target='DROP'
            uci set firewall."$SECTION_NAME".enabled='1'
            uci commit firewall
            fw4 reload >/dev/null 2>&1
        fi
        ;;

    remove_block)
        MAC=$(echo "$2" | tr '[:lower:]' '[:upper:]')
        [ -z "$MAC" ] && exit 1
        SECTION_NAME="macblock_$(clean_mac "$MAC")"

        if uci get firewall."$SECTION_NAME" >/dev/null 2>&1; then
            uci delete firewall."$SECTION_NAME"
            uci commit firewall
            fw4 reload >/dev/null 2>&1
        fi

        init_nft_set
        nft delete element $TABLE $SET_NAME "{ $MAC }" 2>/dev/null
        ;;

    list_blocked)
        init_nft_set
        uci show firewall | grep "MacControl_Block_" | while read -r line; do
            SEC=$(echo "$line" | cut -d'.' -f2)
            MAC=$(uci get firewall."$SEC".src_mac 2>/dev/null | tr '[:lower:]' '[:upper:]')
            
            EXPIRES=$(nft list set $TABLE $SET_NAME 2>/dev/null | grep -i "$MAC" | awk '{for(i=1;i<=NF;i++) if($i=="expires") print $(i+1)}')
            
            if [ -n "$EXPIRES" ]; then
                echo "$MAC|0|$EXPIRES"
            else
                echo "$MAC|1|-"
            fi
        done
        ;;

    temp_allow)
        MAC=$(echo "$2" | tr '[:lower:]' '[:upper:]')
        MINUTES="$3"
        [ -z "$MAC" ] || [ -z "$MINUTES" ] && exit 1

        $0 add_block "$MAC"
        init_nft_set
        nft add element $TABLE $SET_NAME "{ $MAC timeout ${MINUTES}m }"
        ;;

    revoke_temp)
        MAC=$(echo "$2" | tr '[:lower:]' '[:upper:]')
        [ -z "$MAC" ] && exit 1

        init_nft_set
        nft delete element $TABLE $SET_NAME "{ $MAC }" 2>/dev/null
        ;;

    cron_apply)
        sed -i '/# MACCONTROL_SCHEDULE_/d' /etc/crontabs/root 2>/dev/null
        uci show maccontrol | grep "=schedule" | while read -r line; do
            SEC=$(echo "$line" | cut -d'.' -f2 | cut -d'=' -f1)
            ENABLED=$(uci get maccontrol."$SEC".enabled 2>/dev/null)
            [ "$ENABLED" = "1" ] || continue
            
            CRON_EXPR=$(uci get maccontrol."$SEC".cron 2>/dev/null)
            MAC=$(uci get maccontrol."$SEC".mac 2>/dev/null)
            MINUTES=$(uci get maccontrol."$SEC".minutes 2>/dev/null)
            
            if [ -n "$CRON_EXPR" ] && [ -n "$MAC" ] && [ -n "$MINUTES" ]; then
                echo "$CRON_EXPR /usr/sbin/maccontrol-cli temp_allow $MAC $MINUTES # MACCONTROL_SCHEDULE_$SEC" >> /etc/crontabs/root
            fi
        done
        /etc/init.d/cron restart >/dev/null 2>&1
        ;;
esac
