#!/bin/sh /etc/rc.common
START=99
STOP=10
USE_PROCD=1
start_service() {
 . /usr/lib/thinkcy-access/common.sh
 sync_managed
 procd_open_instance
 procd_set_param command /usr/sbin/thinkcy-access-scheduler
 procd_set_param respawn 3600 5 5
 procd_close_instance
}
stop_service() { nft delete table inet thinkcy_access 2>/dev/null; }
