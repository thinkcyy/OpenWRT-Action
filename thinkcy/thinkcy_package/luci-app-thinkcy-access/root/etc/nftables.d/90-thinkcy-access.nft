set thinkcy_managed_macs {
        type ether_addr
}

set thinkcy_allowed_macs {
        type ether_addr
        flags timeout
        timeout 1m
}

chain thinkcy_mac_access_guard {
        type filter hook forward priority -1; policy accept;
        ether saddr @thinkcy_managed_macs oifname != "br-lan" ether saddr != @thinkcy_allowed_macs reject with icmpx type admin-prohibited
}
