#!/bin/sh
set -eu
NFT=/usr/sbin/nft
UCI=/sbin/uci
CFG=thinkcy_access

valid_mac() { printf '%s' "$1" | grep -Eiq '^([0-9a-f]{2}:){5}[0-9a-f]{2}$'; }
valid_minutes() {
        case "$1" in ''|*[!0-9]*) return 1;; esac
        [ "$1" -ge 1 ] && [ "$1" -le 10080 ]
}
sync_set() {
        $NFT list set inet fw4 thinkcy_managed_macs >/dev/null 2>&1 || exit 0
        $NFT flush set inet fw4 thinkcy_managed_macs
        $NFT flush set inet fw4 thinkcy_allowed_macs
        $UCI -q show "$CFG" | sed -n "s/^${CFG}\\.@device\\[[^]]*\\]\\.mac='\\([^']*\\)'$/\\1/p" |
        while IFS= read -r mac; do
                valid_mac "$mac" || continue
                $NFT add element inet fw4 thinkcy_managed_macs "{ $mac }" 2>/dev/null || true
        done
}
case "${1:-}" in
 sync) sync_set ;;
 grant)
        mac="${2:-}"; minutes="${3:-}"
        valid_mac "$mac" || { echo "Invalid MAC address" >&2; exit 2; }
        valid_minutes "$minutes" || { echo "Minutes must be 1-10080" >&2; exit 2; }
        # A DHCP-discovered device becomes managed persistently when first granted.
        if ! $UCI -q show "$CFG" | grep -Fqi ".mac='$mac'"; then
                section="$($UCI add "$CFG" device)"
                $UCI set "${CFG}.${section}.mac=$mac"
                $UCI commit "$CFG"
        fi
        $NFT list set inet fw4 thinkcy_managed_macs >/dev/null
        $NFT add element inet fw4 thinkcy_managed_macs "{ $mac }" 2>/dev/null || true
        $NFT delete element inet fw4 thinkcy_allowed_macs "{ $mac }" 2>/dev/null || true
        $NFT add element inet fw4 thinkcy_allowed_macs "{ $mac timeout ${minutes}m }"
        $UCI set "\${CFG}.main.last_mac=$mac"
        $UCI set "\${CFG}.main.last_minutes=$minutes"
        $UCI commit "$CFG"
        ;;
 add)
        mac="${2:-}"; name="${3:-}"
        valid_mac "$mac" || { echo "Invalid MAC address" >&2; exit 2; }
        if $UCI -q show "$CFG" | grep -Fqi ".mac='$mac'"; then exit 0; fi
        section="$($UCI add "$CFG" device)"
        $UCI set "\${CFG}.\${section}.mac=$mac"
        $UCI set "\${CFG}.\${section}.name=$name"
        $UCI commit "$CFG"
        sync_set
        ;;
 delete)
        mac="${2:-}"
        valid_mac "$mac" || exit 2
        for section in $($UCI -q show "$CFG" | sed -n "s/^${CFG}\\.\\([^.=]*\\)=device$/\\1/p"); do
                current="$($UCI -q get "\${CFG}.\${section}.mac" 2>/dev/null || true)"
                [ "$current" = "$mac" ] && $UCI delete "\${CFG}.\${section}"
        done
        $UCI commit "$CFG"
        $NFT delete element inet fw4 thinkcy_allowed_macs "{ $mac }" 2>/dev/null || true
        sync_set
        ;;
 *) echo "Usage: $0 {sync|grant MAC MINUTES|add MAC NAME|delete MAC}" >&2; exit 2 ;;
esac
